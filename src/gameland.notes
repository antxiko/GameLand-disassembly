L 0x7C32 menu_atras_uno
L 0x6FDA programa              El programa: la pila en 0xF9F1, la VRAM preparada, 0xFA3B = 0x8100; busca el principio de la RAM (de 0xE000 hacia abajo, de 0x800 en 0x800, la primera que no se puede escribir) en 0xFA39 e IY; borde de color 4; 0x95DC; borra la partida (0x7117, 0x714C) y va al menu principal
C 0x6FDA la pila
C 0x6FE0 0x8100
C 0x6FE6 desde 0xE000
L 0x6FE9 programa_ram
C 0x6FE9 el byte...
C 0x6FEA ...dado la vuelta...
C 0x6FEB ...se escribe...
C 0x6FEC ...y se lee: queda?
C 0x6FEE no: ahi no hay RAM
C 0x6FF0 0x800 mas abajo
L 0x6FF5 programa_ram_fin
C 0x6FF5 la ultima que si
C 0x6FF8 el principio de la RAM
C 0x6FFC tambien en IY
C 0x6FFE borde de color 4
L 0x7006 programa_nuevo        Borra la partida que hubiera (0x7117, 0x714C)
C 0x7006 la partida a 0
L 0x700C menu_principal_entra  Todo parado (0x4159), el buffer vacio, sin jugar (0xFA04), sin STOP, la pila de menus vacia (0xF8A8 en 0xFA27, 0xFA7B en 0xFA2D), los colores del texto, 0x9833 y el menu principal
C 0x700C cursores, pantalla y cinta
C 0x7012 sin jugar...
C 0x7016 ...sin STOP...
C 0x701C la pila de menus vacia
C 0x7028 los colores del texto
C 0x702E la pila otra vez
L 0x7031 menu_principal        El menu 1 (jugar, hacer, arreglar, cargar o guardar el juego); con los bytes que siguen, el 5 (0x7034) y el 6 (0x7037): el fondo
