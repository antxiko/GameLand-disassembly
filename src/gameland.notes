# Game Land (Casio, 1984) - anotaciones
D 0x4000 0x4012 cabecera          La cabecera: "AB", INIT 0x402F, sin STATEMENT, DEVICE ni TEXT; en 0x4010, "PX": la marca que busca INIT (y los programas de cinta)
L 0x4012 api                   Nueve "jp" para los programas que se cargan de cinta (Game Land Special): las rutinas del cartucho en sitio fijo
D 0x402D 0x402F api_fin           Dos bytes detras de la tabla (0xC7 0x42)
L 0x402F init                  INIT: busca su propio slot (en cada slot y subslot, "AB" en 0x4000, INIT 0x402F y "PX" en 0x4010), lo pone tambien en la pagina 2, apaga la interrupcion del VDP, borra las zonas de trabajo del BASIC, pone sus ganchos y va al programa (0x6FDA); si no se encuentra, vuelve al BASIC
C 0x402F sin interrupciones
C 0x4030 modo 1
C 0x4032 EXPTBL: si cada slot esta expandido
C 0x4035 el slot 0
L 0x4037 init_slot
C 0x4037 el bit de expandido...
C 0x4038 ...en el slot
C 0x403A guardado
L 0x403B init_mira
C 0x403B en 0x4000...
C 0x403E ...los dos primeros bytes (RDSLT)
C 0x4042 "AB"?
C 0x4045 DCOMPR
C 0x4047 no
C 0x4049 en 0x4002: INIT
C 0x404C 0x402F?
C 0x404F DCOMPR
C 0x4050 no
C 0x4052 en 0x4010...
C 0x4058 ..."PX"?
C 0x405B DCOMPR
C 0x405C si: es este
L 0x405E init_siguiente
C 0x405E expandido?
C 0x4060 no: el slot siguiente
C 0x4063 el subslot siguiente...
C 0x4066 ...hasta el 3
L 0x406D init_slot_sig
C 0x406D el siguiente
C 0x4071 los cuatro?
C 0x4073 no
C 0x4075 no esta: al BASIC
L 0x4076 init_hallado
C 0x4076 el slot...
C 0x4077 ...guardado en 0xFE6B
C 0x407A en la pagina 2
C 0x407D ENASLT
C 0x4081 la interrupcion del VDP apagada
C 0x4084 0xF417-0xF91E a cero
C 0x4091 0xF92A-0xFBD9 a cero
C 0x409D 0xFDEF-0xFEAC a cero
C 0x40A9 los ganchos
C 0x40AC al programa
L 0x40AF ganchos               H.KEYI y 0xFE68 con "ret"; H.TIMI salta a la interrupcion (0x422E)
C 0x40AF "ret"...
C 0x40B1 ...en 0xFE68...
C 0x40B4 ...y en H.KEYI
C 0x40B7 "jp"...
C 0x40B9 ...0x422E...
C 0x40BC ...en H.TIMI
L 0x40C3 slot_lee2             Dos bytes del slot C desde HL (RDSLT): en DE (el primero en E)
L 0x40C7 slot_lee              Un byte del slot C desde HL (RDSLT), en D; HL + 1
C 0x40C7 el slot
C 0x40CA RDSLT
C 0x40D0 el siguiente
L 0x40D2 vram_prepara          La VRAM entera a cero, las letras y los dibujos fijos, el modo de pantalla, los sprites y el sonido; el teclado (0xFE14 = 3, 0xFE15 = 0x10) y la interrupcion del VDP encendida
C 0x40D2 desde 0...
C 0x40D5 ...16 KB...
C 0x40D8 ...a cero (FILVRM)
L 0x40F5 letras_pon            Las casillas de 0x1C00 a cero, dos bytes 0xFF (0x1D49), 13 dibujos de 8 bytes desde 0xA881 cada 32 (desde 0x1C80), cuatro y cuatro mas y 0x60 bytes en 0x1F00
L 0x4133 cuatro_dibujos        Cuatro veces 8 bytes de HL a DE (DE + 8 cada vez); HL, 8 mas
L 0x4161 pantalla_texto        Lo de 0x4BB6 (y, si da C, 0x4BC4), 0xFA1B y 0xFE0F a cero, la pantalla de texto y el registro 7 del VDP
L 0x4177 cinta_para            TAPIOF: la cinta, parada
C 0x4177 TAPIOF
L 0x417C vdp_7                 El registro 7 del VDP (el color del borde) = A
C 0x417E el registro 7
C 0x4180 WRTVDP
L 0x4185 vdp_int_on            La interrupcion del VDP encendida (registro 1, bit 5)
C 0x4186 bit 5 a 1
L 0x418B vdp_int_off           La interrupcion del VDP apagada (registro 1, bit 5 a 0)
C 0x418B sin interrupciones
C 0x418D bit 5 a 0
L 0x4190 vdp_reg1
C 0x4191 RG1SAV...
C 0x4194 ...con B...
C 0x4195 ...y C
C 0x4197 el registro 1
C 0x4199 WRTVDP
C 0x419C RDVDP: el estado leido
L 0x41A2 ldirvm                LDIRVM guardando BC, DE y HL
C 0x41A5 LDIRVM
L 0x41A8 pops3
L 0x41AC ldirmv                LDIRMV guardando BC, DE y HL
C 0x41AF LDIRMV
L 0x41B4 ldirmv_mas            LDIRMV y DE + BC
L 0x41BB ldirvm_mas            LDIRVM y HL + BC
L 0x41C0 boton                 GTTRIG A (0-4); 5 o mas: la tecla de la fila 7, bit 7 (RETURN): 0xFF pulsada
C 0x41C0 0-4?
C 0x41C2 GTTRIG
C 0x41C6 la fila 7
C 0x41C8 SNSMAT
C 0x41CC el bit 7 (RETURN)
C 0x41CD 0: pulsada, 0xFF...
L 0x41D2 psg_callar            Los volumenes del PSG (registros 8-10) a 0
C 0x41D2 el registro 8
C 0x41D6 WRTPSG
C 0x41DA hasta el 10
L 0x41DF psg_cero              Los volumenes a 0 y el mezclador (registro 7) a 0xB8
C 0x41E4 0xB8: tonos, sin ruido
C 0x41E6 WRTPSG
L 0x422E interrupcion          La interrupcion (H.TIMI): no vuelve a la BIOS; guarda el estado del VDP (0xF9FE), cuenta hacia atras 0xFA31, el sonido (0xA20C), 0xFE6F y 0xFE70; jugando (0xFA04), cada 3 cuadros la palanca (0xF9FB) y los botones; si no, el teclado; despues 0xFE68 y saca de la pila todo lo que guardo la BIOS
C 0x422E sin interrupciones
C 0x422F fuera la vuelta a la BIOS
C 0x4230 el estado del VDP: el bit 5 (choque de sprites)?
C 0x4234 guardado
C 0x4237 la cuenta de 0xFA31...
C 0x423A ...uno menos
C 0x423E el sonido
C 0x4241 0xFE6F...
C 0x4248 ...uno menos, si no es 0
C 0x4249 0xFE70 + 0x20...
C 0x4250 sin acarreo: nada
C 0x4252 + 1 abajo
C 0x4255 5?
C 0x4259 vuelve a 1
L 0x425B interrupcion_mandos
C 0x425B jugando?
C 0x425F no: el teclado
C 0x4261 cada 3 cuadros
C 0x4267 otra vez 3
C 0x4269 GTSTCK 0: los cursores...
C 0x426E ...o...
C 0x4270 ...el mando 1...
C 0x4278 ...o el 2
L 0x427E interrupcion_palanca
C 0x427E la palanca
C 0x4281 tres botones
C 0x4284 la cuenta de 0xFE15
C 0x428C los botones de 0, 1, 2 en 0xF9FC
L 0x428F interrupcion_boton
C 0x4291 pulsado?
C 0x4296 no
C 0x4298 si: 3 cuadros...
C 0x429D ...y apuntado
C 0x42A3 los de 3, 4, 5 en 0xF9FD
L 0x42B9 interrupcion_tecla
C 0x42B9 STOP?
L 0x42BE interrupcion_teclado
C 0x42BE el teclado
L 0x42C4 interrupcion_fin
C 0x42C4 el gancho 0xFE68
C 0x42C7 lo que guardo la BIOS, fuera
C 0x42D5 con interrupciones
C 0x42D6 de vuelta al programa
L 0x42D7 teclado_cada3         Cada 3 cuadros (0xFE14): STOP y el teclado
L 0x42E4 stop_mira             STOP solo (la fila 7 = 0xEF) en cuatro lecturas seguidas: 0xFA06 = 0xFF
C 0x42E4 cuatro veces
C 0x42E6 la fila 7
C 0x42E8 SNSMAT
C 0x42EB solo STOP? (0xEF + 0x11 = 0)
C 0x42ED no
C 0x42F0 si: 0xFA06 = 0xFF
L 0x42F6 teclado                El teclado: si cambia (0x4312), cada tanto (0xFE15) las teclas pulsadas pasan a codigos (0x436B)
L 0x4312 teclado_lee           Las palancas 0-2 (0xFE30), los botones 0-5 (bits de 0xFE33) y las 11 filas del teclado (0xFE25, por los puertos 0xAA y 0xA9); si alguna cambia, 0xFE15 = 16
C 0x4313 las palancas
L 0x4316 teclado_palanca
C 0x4318 GTSTCK
C 0x4325 seis botones
L 0x4328 teclado_boton
C 0x432B pulsado?
C 0x4330 su bit
C 0x4335 apuntados
C 0x4336 jugando?
C 0x433C no: sin el mando 2
L 0x4340 teclado_filas
C 0x4340 el puerto C del PPI...
C 0x4342 ...sin la fila
C 0x4345 11 filas
C 0x4347 a 0xFE25
L 0x434A teclado_fila
C 0x434B la fila
C 0x434D sus teclas
C 0x434F apuntadas
C 0x4354 contra las de antes (0xFE16)
L 0x435C teclado_compara
C 0x435C la de antes...
C 0x435D ...igual?
C 0x4362 las 15
C 0x4364 iguales
L 0x4366 teclado_cambia
C 0x4366 distinta: 16 cuadros
L 0x436B teclado_codigos       Las teclas pulsadas, a sus codigos (las tablas de 0x44C6 o 0x4474, la segunda con 0xFA1C distinto de 0x10); con CODE (0xFE13) y SHIFT o GRAPH otra columna; los cambios de las palancas a codigos de cursor (0x450E)
C 0x4389 la tabla con 0xFA1C = 0x10
C 0x4397 si no, la otra
C 0x439A apuntada
C 0x43A1 la tecla CODE...
C 0x43A6 con CODE: la columna 0x20...
C 0x43A8 ...SHIFT?
C 0x43AC ...0x28 con GRAPH
C 0x43B1 sin las dos: 0xFE2D bit 0
L 0x43B6 teclado_columna
C 0x43B6 la columna 0x18...
C 0x43B8 ...SHIFT (0xFE2B bit 0)?
C 0x43BE ...0x30
C 0x43C3 ...0x10
L 0x43C5 teclado_palancas      Las palancas que cambian (0xFE31/0xFE22, 0xFE30/0xFE21, 0xFE32/0xFE23): su direccion - 1 con la columna, al buffer (0x450E)
C 0x43C5 la palanca de antes...
C 0x43C8 ...y la de ahora
C 0x43CC cambia?
C 0x43CD guardada
C 0x43D0 suelta?
C 0x43D3 la direccion - 1...
C 0x43D4 ...con la columna...
C 0x43D5 ...y el bit 7
C 0x43D7 al buffer
L 0x43DA teclado_palanca0
C 0x43DC la palanca 0
C 0x43E6 al buffer
L 0x43E9 teclado_palanca2
C 0x43ED la palanca 2
C 0x43F6 0xD0 + direccion
C 0x43F8 al buffer
L 0x43FB teclado_botones       Los botones que cambian (0xFE33 contra 0xFE24): 0x8E, 0xCE, 0x8F y 0xCF al buffer
C 0x43FB los de antes
C 0x43FE los de ahora
C 0x4401 iguales?
C 0x4402 guardados
C 0x440A el boton 1: 0x8E
C 0x4411 el 2: 0xCE
C 0x4418 el 3: 0x8F
C 0x441F el 4: 0xCF
L 0x4424 teclado_filas_nuevas  Las 11 filas: las teclas recien pulsadas de cada una (bit a 0 ahora y a 1 antes) a codigos (0x4448)
C 0x4424 11 filas
C 0x4426 las de antes
C 0x4429 las de ahora
L 0x442C teclado_fila_nueva
C 0x442C la de ahora...
C 0x442E ...las que cambian...
C 0x442F ...y estaban sueltas: recien pulsadas
C 0x4430 guardada
C 0x4431 alguna: a codigos
C 0x4438 las teclas de antes...
C 0x4439 ...guardadas
C 0x443F el buffer: donde se escribe...
C 0x4442 ...y donde se lee
C 0x4446 iguales: Z (vacio)
L 0x4448 tecla_fila            Las 8 teclas de una fila (A, sus bits recien pulsados): su numero (fila x 8 + bit) a la tabla del teclado (0x4465)
C 0x444C 11 - las que quedan: la fila
C 0x444F x 8
C 0x4453 8 bits
L 0x4456 tecla_bit
C 0x4456 el bit siguiente
C 0x4459 pulsada: su codigo
C 0x445E la tecla siguiente
L 0x4465 tecla_codigo          La tecla C en la tabla del teclado (0xFE11): pares de umbral y rutina; la primera con el umbral mayor que C (salta con "ret")
C 0x4465 la tabla
L 0x4469 tecla_codigo_mira
C 0x4469 por debajo del umbral?
C 0x446B la rutina...
C 0x446F ...a la pila
C 0x4470 si: a ella (ret)
C 0x4471 no: la siguiente
D 0x4474 0x448F teclado_tabla_a   La tabla del teclado con 0xFA1C distinto de 0x10: umbral (el numero de tecla) y rutina, hasta 0xFF
L 0x448F tecla_fila0           Las teclas 0-7 (los numeros): + 0x30
L 0x4497 tecla_letra
C 0x4497 + 0x37
D 0x449B 0x44DE teclado_numeros   Los codigos de las teclas, por su numero (0x4485 + n y 0x44C5 + n), y la tabla del teclado con 0xFA1C = 0x10 (0x44C6)
L 0x44DE tecla_tabla1          El codigo de la tecla en la tabla de 0x4485 + n
L 0x44E3 tecla_tabla2          El codigo de la tecla en la tabla de 0x44C5 + n
L 0x44E6 tecla_tabla
C 0x44E6 + la tecla
C 0x44E9 su codigo
C 0x44EA ninguno?
C 0x44EB nada
C 0x44EC al buffer
L 0x44EE tecla_mas2b
C 0x44EE + 0x2B
L 0x44F2 tecla_mas30
C 0x44F2 + 0x30
L 0x44F4 tecla_al_buffer
L 0x44F6 tecla_2c
C 0x44F6 0x2C
D 0x44FA 0x4506 teclado_codigos2  Mas codigos de tecla
L 0x4506 tecla_stop            La tecla de la pausa: si 0xFE2B bit 1 no esta, el codigo 5
C 0x4506 CTRL?
C 0x450C el codigo 5
L 0x450E buffer_pon            Un codigo (A) al buffer del teclado (0xFE3B-0xFE5A, 0xFE37 donde se escribe): con CODE, el 0x0E solo si 0xFBD1; pasa por 0x9AF7 antes
C 0x4510 CODE?
C 0x4516 no
C 0x4518 0x0E?
C 0x451C 0xFBD1?
C 0x4520 no: nada
L 0x4523 buffer_pon_va
C 0x4523 el codigo, por 0x9AF7
C 0x4528 donde se escribe
C 0x452B el codigo
C 0x452D el final del buffer?
C 0x4533 si: al principio
L 0x4536 buffer_pon_lleno
C 0x4536 donde se lee
C 0x453A lleno?
C 0x453B si: se pierde
C 0x453D si no, apuntado
L 0x4542 buffer_saca           El codigo siguiente del buffer del teclado (Z si esta vacio)
C 0x4544 donde se lee...
C 0x4547 ...y donde se escribe
C 0x454B vacio?
C 0x454C si: Z
C 0x454E el codigo
C 0x4550 el siguiente
C 0x4554 el final?
C 0x4557 si: al principio
L 0x455A buffer_saca_va
C 0x455A apuntado
L 0x455E buffer_fin
L 0x4561 buffer_vacia          El buffer vacio; con 0xFE10, el codigo 0x0F (dos si 0xFE6D = 0x0404) y despues el 7
C 0x4561 el principio...
C 0x4564 ...donde se lee...
C 0x4567 ...y donde se escribe
C 0x456A 0xFE10?
C 0x456E no
C 0x4570 0xFE6D y 0xFE6E...
C 0x4573 ...4 y 4?
C 0x457B si: un 0x0F mas
L 0x4580 buffer_vacia_0f
C 0x4580 el 0x0F
L 0x4583 buffer_vacia_7
C 0x4583 el 7
L 0x4587 cartucho_cp           Busca otro cartucho con "AB" en 0x4000 o 0x8000 y "CP", 0xED00 y una direccion en +0x10: si esta, llama a esa direccion en su slot (CALSLT) y vuelve con NC; si no, C
C 0x4587 sin interrupciones
C 0x4588 EXPTBL
C 0x458B el slot 0
L 0x458D cartucho_cp_slot
C 0x458D con su bit de expandido
L 0x4590 cartucho_cp_mira
C 0x4591 en 0x4000...
C 0x4594 ...dos bytes
C 0x4598 "AB"?
C 0x459D si: mira el resto
C 0x45A1 hallado
C 0x45A3 en 0x8000
C 0x45AA "AB"?
C 0x45B3 hallado
C 0x45B4 expandido?
C 0x45B6 no
C 0x45B9 el subslot siguiente
L 0x45C0 cartucho_cp_sig
C 0x45C0 el slot siguiente
C 0x45C3 los cuatro?
C 0x45C7 ninguno: C
L 0x45CA cartucho_cp_cabecera
C 0x45CA en +0x10...
C 0x45D0 ..."CP"?
C 0x45D5 no
C 0x45DA 0xED00?
C 0x45DF no
C 0x45E0 la direccion
C 0x45E3 IY: el slot
C 0x45E7 IX: la direccion
C 0x45EA sin la interrupcion del VDP
C 0x45ED CALSLT
C 0x45F0 con ella otra vez
C 0x45F3 NC: hecho
L 0x45F6 cursores_pon          Los cursores del editor otra vez en pantalla: sin parpadeo (0xFE5D), lo de 0x6746, la cuenta del parpadeo a 10; con 0xFE5E, las Y de los cuatro sprites del objeto (desde 0x61F1) a 0xFE64; despues los cursores que pide 0xFE5F (bits 7-3, la tabla de 0x4644) y el parpadeo encendido (0xFE5B)
C 0x45F6 sin interrupciones
C 0x45F7 el paso del parpadeo a 0
C 0x45FE 10 cuadros...
C 0x4600 ...la cuenta del parpadeo
C 0x4603 0xFE5E?
C 0x4607 no
C 0x460A su sitio en la VRAM
C 0x460D cuatro sprites
C 0x460F a 0xFE64
L 0x4612 cursores_y
C 0x4612 RDVRM: su Y
C 0x4615 guardada
C 0x4617 el siguiente (+4)
C 0x461D el parpadeo, desde el principio
L 0x4624 cursores_cuales
C 0x4624 los cursores pedidos (bits 7-3)
C 0x4629 ninguno
C 0x462B la tabla de 0x4644
L 0x462E cursores_bit
C 0x462E el bit siguiente
C 0x462F a 0: el siguiente
C 0x4633 su rutina
L 0x4639 cursores_sig
C 0x4639 la rutina siguiente
C 0x463B quedan bits
L 0x463D cursores_fin
C 0x463D el parpadeo encendido
C 0x4642 con interrupciones
D 0x4644 0x464E cursores_tabla    Las rutinas de los cursores por los bits 7-3 de 0xFE5F: 0x464E, 0x46BA, 0x46AE, 0x468C y 0x4664
L 0x464E cursor_linea          El sprite 0x2B en la fila de 0xFBC5 (x 8, + 8) y de color 15
C 0x464E el sprite 0x2B
C 0x4650 la fila (0xFBC5)...
C 0x4654 ...x 8...
C 0x4657 ...+ 8
L 0x465C cursor_pon_15
C 0x465C en su sitio
C 0x465F color 15
L 0x4664 cursor_casilla        El sprite 0x2C en la casilla de 0xFBC3 (columna y fila dentro de su cuadro de 8 x 8, desde la 0x17 y la 0x10); con 0xFE6C 3 o mas, el de 0x6BCF
C 0x4664 0xFE6C...
C 0x4667 ...menos de 3?
C 0x466B si no, el otro
L 0x466E cursor_casilla_va
C 0x466E la casilla (0xFBC3)
C 0x4671 la fila (0-7)...
C 0x4674 ...+ 0x10
C 0x4677 la columna (0-7)...
C 0x467A ...+ 0x17
C 0x467D el sprite 0x2C
L 0x467F cursor_por8
C 0x467F x 8: en pixeles
L 0x4684 cursor_dos_b          Los sprites 0x2F y 0x30 en la posicion de 0xFBCB
C 0x4684 la posicion
C 0x4687 los sprites 0x30 y 0x2F
L 0x468C cursor_dos            Los sprites 0x2D y 0x2E en la posicion de 0xFBC3 (+8 - 4 en X e Y): el primero de color 15, el segundo de color 1
C 0x468C la posicion
C 0x468F los sprites 0x2E y 0x2D
L 0x4692 cursor_dos_va
C 0x4693 + 8...
C 0x4697 ...- 4 en las dos
C 0x46A0 el primero, color 15
C 0x46A5 el segundo
C 0x46A6 en su sitio
C 0x46A9 color 1
L 0x46AE cursor_lista          El sprite 0x2A en la fila de 0xFBF8 (x 2 + 0x17, x 8)
C 0x46AE la fila
C 0x46B6 el sprite 0x2A
L 0x46BA cursor_otro           Lo de 0x6A9D con A = 0xFF
C 0x46BA 0xFF
L 0x46BD cursor_otro_va
L 0x46C1 cursores_fuera        Los sprites 0x2F y 0x30 fuera (Y 0xC1)
C 0x46C1 el 0x2F
C 0x46C3 fuera
C 0x46C8 el 0x30
L 0x46CA sprite_fuera          El sprite C fuera (Y 0xC1)
C 0x46CA Y 0xC1
L 0x46CF cursores_quita        Los cursores fuera: sin parpadeo, lo de 0x6747; con 0xFE5E, sus Y de vuelta (0x470C) y, con el bit 3 de 0xFE5F, 0x6BD0; si no, los sprites 0x2B-0x2E y 0x2A fuera (0x4707); con el bit 6, 0x46BD
C 0x46CF sin interrupciones
C 0x46D0 el parpadeo apagado
C 0x46DA 0xFE5E?
C 0x46DE no
C 0x46E0 las Y de vuelta
C 0x46E3 el bit 3 de 0xFE5F?
L 0x46ED cursores_quita_lista
C 0x46ED los sprites de 0x4707...
C 0x46F0 ...cinco
L 0x46F2 cursores_quita_uno
C 0x46F4 su numero
C 0x46F5 fuera
L 0x46FD cursores_quita_fin
C 0x46FD el bit 6 de 0xFE5F?
C 0x4705 con interrupciones
D 0x4707 0x470C cursores_sprites  Los cinco sprites de los cursores: 0x2B, 0x2C, 0x2D, 0x2E y 0x2A
L 0x470C parpadeo_reinicia     El paso del parpadeo a 0 y a pintar
C 0x470C el paso a 0
L 0x4712 parpadeo              Cada cuadro, desde la interrupcion: con el parpadeo encendido, cada 10 cuadros (0xFE5C) un paso: los sprites del objeto (0xFE5E) se alternan con sus colores (los cuatro de la paleta de 0xFC49 en 0xFDEF) o, sin objeto, los cursores cambian de color (15 y 1)
C 0x4712 encendido?
C 0x4716 no
C 0x4717 la cuenta...
C 0x471A ...uno menos
C 0x471C otra vez 10
C 0x471E 0xFE5E?
C 0x4723 no: los cursores
L 0x4726 parpadeo_objeto
C 0x4726 el sprite 0xC4 (el primero del objeto)
C 0x4729 el color de fondo (0xFC49)...
C 0x472C ...0-7...
C 0x472E ...x 4
C 0x4731 + 0x20
C 0x4735 los colores de 0xFDEF
C 0x4739 + el de fondo x 4
C 0x473C a 0xFE60
C 0x473F cuatro
C 0x4745 sus Y guardadas
C 0x4748 el paso
C 0x474D 0 o 2: pintados
C 0x4751 2?
C 0x4753 1 o 3: fuera
