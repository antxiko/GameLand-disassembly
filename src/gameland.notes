C 0x707D cargado
C 0x707F "no se ha podido cargar"
L 0x7086 menu_guardar          Guardar el juego en la cinta: el nombre (menu 8, 10 letras), a 0xFA49; si acaba en ",F", 0xFE72 = 0 (si no, 1); se graba (0x6D17) y despues el menu 0x0A (comprobar?): con "si", lo lee y lo compara (0x6E5C); si falla, el aviso 0x15
C 0x708A el nombre
C 0x7094 8 letras...
C 0x7097 ...a 0xFA49
C 0x709C ","?
C 0x70A2 "F"?
L 0x70A7 menu_guardar_graba
C 0x70A7 0xFE72 = 1, o 0 con ",F"
C 0x70AC a la cinta
C 0x70AF interrumpido: otra vez
L 0x70B1 menu_comprueba
C 0x70B1 el menu 0x0A: comprobar?
C 0x70B6 no: al menu principal
C 0x70BD lo que hay en la cinta, comparado
C 0x70C0 interrumpido: otra vez
C 0x70C2 igual
C 0x70C5 "no se ha guardado bien"
L 0x70CC menu_arregla          Arreglar (opcion 3) o guardar (opcion 5) el juego: si no hay ninguno, el aviso 9; con la 3, 0xF9F2-0xF9F4 a 0 y el menu 0x0C (fondo, personajes, sonido o historia)
C 0x70CF no hay juego
C 0x70D1 la opcion 3?
C 0x70D4 no, la 5: guardar
C 0x70DE el menu 0x0C
L 0x70E1 sin_juego             El aviso 9 ("no hay juego") y al menu principal
